# Required
OPENROUTER_KEY=sk-or-v1-...

# Security (strongly recommended when the app is reachable by others)
# APP_PASSWORD=change-me            # enables the login screen
# API_KEYS=key1,key2               # programmatic access: "Authorization: Bearer key1" (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
# SECRET_KEY=                       # signs session cookies; auto-generated in DATA_DIR if empty
# RATE_LIMIT_PER_MIN=20             # LLM requests per IP per minute per worker (0 = off)
# EXEC_RATE_LIMIT_PER_MIN=60        # hand-written SQL runs per IP per minute (0 = off)
# DAILY_BUDGET_USD=5                # stop LLM calls once today's spend (UTC) reaches this (0 = off)
# AUDIT_RETENTION_DAYS=90           # audit log of executed SQL (0 = keep forever)
# HIDDEN_COLUMNS=*.password*,*.secret*,*.ssn   # hidden from the model and blocked in queries (globs: table or table.column);
#                                   # defaults cover passwords/secrets/tokens/card numbers, empty value disables
# FORWARDED_ALLOW_IPS=127.0.0.1     # trust X-Forwarded-For only from your reverse proxy

# Use another OpenAI-compatible endpoint instead of OpenRouter (local servers need no key), e.g. Ollama:
# LLM_URL=http://localhost:11434/v1/chat/completions      # from Docker: http://host.docker.internal:11434/...
# OPENROUTER_MODEL=qwen2.5-coder:7b
# OPENROUTER_MODELS=qwen2.5-coder:7b

# Models
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# OPENROUTER_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,openai/gpt-5.5,google/gemini-3.8-flash,deepseek/deepseek-v4.1-flash

# Limits
# MAX_ROWS=1000
# QUERY_TIMEOUT_S=10
# MAX_RETRIES=2
# MAX_UPLOAD_MB=50
# SCHEMA_SELECT_MIN_TABLES=15       # above this many tables, pick relevant tables first
# SCHEMA_SELECT_CHARS=16000
